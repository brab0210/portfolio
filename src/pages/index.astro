---
// Redirección de la raíz al idioma predeterminado (/es/)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/es/" />
    <link rel="canonical" href="/es/" />
    <title>Bernardo Arrechea | Data Engineer Jr.</title>
    <script is:inline>
      // Detección opcional del idioma del navegador si prefiere inglés
      const browserLang = navigator.language?.slice(0, 2);
      if (browserLang === 'en') {
        window.location.replace('/en/');
      } else {
        window.location.replace('/es/');
      }
    </script>
  </head>
  <body class="bg-[#09090b] text-zinc-400 flex items-center justify-center min-h-screen font-mono text-xs">
    <p>Redirigiendo a <a href="/es/" class="text-zinc-100 underline">/es/</a>...</p>
  </body>
</html>
