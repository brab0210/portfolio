---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const principles = [
  {
    num: '01',
    title: t('about.p1_title'),
    desc: t('about.p1_desc'),
  },
  {
    num: '02',
    title: t('about.p2_title'),
    desc: t('about.p2_desc'),
  },
  {
    num: '03',
    title: t('about.p3_title'),
    desc: t('about.p3_desc'),
  },
];

const valueProps = [
  t('about.val_1'),
  t('about.val_2'),
  t('about.val_3'),
  t('about.val_4'),
];
---

<section
  id="sobre-mi"
  class="scroll-reveal opacity-0 translate-y-8 transition-all duration-500 ease-out space-y-8 scroll-mt-20"
  aria-labelledby="about-section-heading"
>
  <!-- Section Header -->
  <div class="border-b border-zinc-200/80 dark:border-zinc-800/80 pb-5 space-y-2">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs uppercase tracking-wider text-indigo-600 dark:text-indigo-400 font-semibold">
        {t('about.section_badge')}
      </span>
    </div>
    <h2
      id="about-section-heading"
      class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50"
    >
      {t('about.section_title')}
    </h2>
    <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">
      {t('about.section_subtitle')}
    </p>
  </div>

  <!-- Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left Column: Story & Engineering Principles (7 cols) -->
    <div class="lg:col-span-7 flex flex-col gap-6">
      <!-- Story Narrative Card -->
      <div class="rounded-2xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-zinc-900/40 p-6 sm:p-7 space-y-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed shadow-xs">
        <p>
          {t('about.story_p1')}
        </p>
        <p>
          {t('about.story_p2')}
        </p>
      </div>

      <!-- Principles Card (Stretches to match the right column total height) -->
      <div class="flex-1 rounded-2xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-zinc-900/40 p-6 sm:p-7 flex flex-col justify-between shadow-xs">
        <div class="flex items-center justify-between border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3 mb-4">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
            {t('about.principles_title')}
          </h3>
          <span class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500">
            [best_practices]
          </span>
        </div>

        <div class="flex-1 flex flex-col justify-between gap-3">
          {principles.map((p) => (
            <div class="flex-1 flex flex-col justify-center p-3.5 rounded-xl bg-zinc-50/70 dark:bg-zinc-900/50 border border-zinc-200/70 dark:border-zinc-800/70 space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                  {p.num}
                </span>
                <h4 class="text-xs font-bold text-zinc-950 dark:text-zinc-100">
                  {p.title}
                </h4>
              </div>
              <p class="text-[11px] sm:text-xs text-zinc-600 dark:text-zinc-400 pl-6 leading-relaxed">
                {p.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Education, Value Add & Quick Specs (5 cols) -->
    <div class="lg:col-span-5 flex flex-col gap-6">
      <!-- Education & Continuous Learning Card -->
      <div class="rounded-2xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-zinc-900/40 p-6 space-y-4 shadow-xs">
        <div class="flex items-center justify-between border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            {t('about.education_title')}
          </h3>
          <span class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500">
            [education]
          </span>
        </div>

        <div class="space-y-3 text-xs">
          <!-- Data Engineering Track -->
          <div class="p-3 rounded-xl bg-zinc-50/70 dark:bg-zinc-900/50 border border-zinc-200/70 dark:border-zinc-800/70 space-y-1">
            <h4 class="font-bold text-zinc-900 dark:text-zinc-100">
              {t('about.edu_de_title')}
            </h4>
            <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {t('about.edu_de_desc')}
            </p>
          </div>

          <!-- Software Dev Track -->
          <div class="p-3 rounded-xl bg-zinc-50/70 dark:bg-zinc-900/50 border border-zinc-200/70 dark:border-zinc-800/70 space-y-1">
            <h4 class="font-bold text-zinc-900 dark:text-zinc-100">
              {t('about.edu_dev_title')}
            </h4>
            <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {t('about.edu_dev_desc')}
            </p>
          </div>
        </div>
      </div>

      <!-- What I Bring to a Data Team Card -->
      <div class="rounded-2xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-zinc-900/40 p-6 space-y-4 shadow-xs">
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3">
          {t('about.value_title')}
        </h3>

        <ul class="space-y-2.5 text-xs text-zinc-600 dark:text-zinc-400">
          {valueProps.map((val) => (
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="leading-snug text-zinc-700 dark:text-zinc-300 font-normal">
                {val}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Specs & Download CV -->
      <div class="rounded-2xl border border-zinc-200/90 dark:border-zinc-800/90 bg-zinc-50/60 dark:bg-zinc-900/30 p-5 space-y-3.5 text-xs">
        <div class="space-y-1">
          <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 block">
            {t('about.location_title')}
          </span>
          <p class="font-medium text-zinc-800 dark:text-zinc-200">
            {t('about.location_val')}
          </p>
        </div>

        <div class="space-y-1 pt-2 border-t border-zinc-200/70 dark:border-zinc-800/70">
          <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 block">
            {t('about.languages_title')}
          </span>
          <p class="font-medium text-zinc-800 dark:text-zinc-200">
            {t('about.languages_val')}
          </p>
        </div>

        <div class="pt-2">
          <a
            href="/cv-bernardo-arrechea.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg font-mono text-xs font-semibold bg-zinc-900 hover:bg-zinc-800 text-white dark:bg-zinc-100 dark:hover:bg-zinc-200 dark:text-zinc-950 transition-colors shadow-xs"
          >
            <span>{t('hero.cta_resume')}</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
