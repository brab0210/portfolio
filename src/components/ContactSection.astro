---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const email = 'bernardoarrechea@gmail.com';
---

<section
  id="contacto"
  class="scroll-reveal opacity-0 translate-y-8 transition-all duration-500 ease-out space-y-8 scroll-mt-20"
  aria-labelledby="contact-section-heading"
>
  <!-- Section Header -->
  <div class="border-b border-zinc-200/80 dark:border-zinc-800/80 pb-5 space-y-2">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs uppercase tracking-wider text-indigo-600 dark:text-indigo-400 font-semibold">
        {t('contact.section_badge')}
      </span>
    </div>
    <h2
      id="contact-section-heading"
      class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50"
    >
      {t('contact.section_title')}
    </h2>
    <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">
      {t('contact.section_subtitle')}
    </p>
  </div>

  <!-- Main Contact Card -->
  <div class="rounded-2xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-zinc-900/40 p-6 sm:p-8 space-y-6 shadow-xs">
    <!-- Primary Email Action Box -->
    <div class="p-5 sm:p-6 rounded-xl bg-zinc-50/80 dark:bg-zinc-900/70 border border-zinc-200/80 dark:border-zinc-800/80 flex flex-col md:flex-row md:items-center justify-between gap-5">
      <div class="space-y-1 min-w-0">
        <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 block">
          {t('contact.email_label')}
        </span>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-indigo-500 dark:text-indigo-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="font-mono text-sm sm:text-base font-semibold text-zinc-950 dark:text-zinc-50 select-all truncate">
            {email}
          </span>
        </div>
      </div>

      <!-- Action Buttons: Copy & Mailto -->
      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <button
          type="button"
          data-copy-email={email}
          data-copied-text={t('contact.copied')}
          data-default-text={t('contact.copy_email')}
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg font-mono text-xs font-semibold bg-zinc-900 hover:bg-zinc-800 text-white dark:bg-zinc-100 dark:hover:bg-zinc-200 dark:text-zinc-950 transition-colors shadow-2xs focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 cursor-pointer"
          aria-label={t('contact.copy_email')}
        >
          <!-- Copy icon -->
          <svg class="w-3.5 h-3.5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <!-- Check icon (hidden initially) -->
          <svg class="w-3.5 h-3.5 check-icon hidden text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span class="button-label">{t('contact.copy_email')}</span>
        </button>

        <a
          href={`mailto:${email}`}
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg font-mono text-xs font-medium border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-zinc-400 dark:hover:border-zinc-600 hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors shadow-2xs"
        >
          <span>{t('contact.open_email')}</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Direct Channels Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-2">
      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/bernardoarrechea"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/40 hover:border-zinc-300 dark:hover:border-zinc-700 hover:bg-white dark:hover:bg-zinc-900/80 transition-all space-y-1.5 shadow-2xs"
      >
        <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400">
          <svg class="w-5 h-5 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64c-.95 0-1.72.78-1.72 1.73s.77 1.73 1.72 1.73 1.73-.78 1.73-1.73-.78-1.73-1.73-1.73Z"/>
          </svg>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
        <h3 class="text-xs font-bold text-zinc-900 dark:text-zinc-100">
          LinkedIn
        </h3>
        <p class="text-[11px] text-zinc-500 dark:text-zinc-400 truncate font-mono">
          /in/bernardoarrechea
        </p>
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/brab0210"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/40 hover:border-zinc-300 dark:hover:border-zinc-700 hover:bg-white dark:hover:bg-zinc-900/80 transition-all space-y-1.5 shadow-2xs"
      >
        <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400">
          <svg class="w-5 h-5 text-zinc-900 dark:text-zinc-100" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
        <h3 class="text-xs font-bold text-zinc-900 dark:text-zinc-100">
          GitHub
        </h3>
        <p class="text-[11px] text-zinc-500 dark:text-zinc-400 truncate font-mono">
          github.com/brab0210
        </p>
      </a>

      <!-- Curriculum Vitae -->
      <a
        href="/cv-bernardo-arrechea.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/40 hover:border-zinc-300 dark:hover:border-zinc-700 hover:bg-white dark:hover:bg-zinc-900/80 transition-all space-y-1.5 shadow-2xs"
      >
        <div class="flex items-center justify-between text-zinc-500 dark:text-zinc-400">
          <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded bg-zinc-200/70 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 font-medium">
            PDF
          </span>
        </div>
        <h3 class="text-xs font-bold text-zinc-900 dark:text-zinc-100">
          {t('contact.cv_download')}
        </h3>
        <p class="text-[11px] text-zinc-500 dark:text-zinc-400 truncate font-mono">
          cv-bernardo-arrechea.pdf
        </p>
      </a>
    </div>

    <!-- Status & Response Time Banner -->
    <div class="pt-4 border-t border-zinc-200/80 dark:border-zinc-800/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-zinc-500 dark:text-zinc-400">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-medium text-zinc-800 dark:text-zinc-200">
          {t('contact.availability_title')} {t('contact.availability_desc')}
        </span>
      </div>
      <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
        {t('contact.response_time')}
      </span>
    </div>
  </div>
</section>

<!-- Clipboard Copy Handler Script -->
<script>
  function initCopyButtons() {
    const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-email]');
    
    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const emailToCopy = btn.getAttribute('data-copy-email') || '';
        const copiedText = btn.getAttribute('data-copied-text') || 'Copied!';
        const defaultText = btn.getAttribute('data-default-text') || 'Copy email';
        const label = btn.querySelector('.button-label');
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');

        if (!emailToCopy) return;

        try {
          await navigator.clipboard.writeText(emailToCopy);
          if (label) label.textContent = copiedText;
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');

          setTimeout(() => {
            if (label) label.textContent = defaultText;
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
          }, 2500);
        } catch (err) {
          console.error('Failed to copy to clipboard:', err);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCopyButtons);
  } else {
    initCopyButtons();
  }
</script>
