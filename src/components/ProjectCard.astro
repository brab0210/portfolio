---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { ProjectCaseStudy } from '../data/projects';
import ProjectArchitectureDiagram from './ProjectArchitectureDiagram.astro';

interface Props {
  project: ProjectCaseStudy;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
---

<article
  id={project.id}
  class="group rounded-2xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white dark:bg-zinc-900/40 shadow-xs hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors p-6 sm:p-8 space-y-6 scroll-mt-24"
  aria-labelledby={`project-title-${project.id}`}
>
  <!-- Card Header: Metadata, Title & External Action Links -->
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-zinc-200/80 dark:border-zinc-800/80 pb-5">
    <div class="space-y-1.5 max-w-2xl">
      <!-- Status Badge -->
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium border border-zinc-200 dark:border-zinc-800 bg-zinc-100/80 dark:bg-zinc-800/60 text-zinc-700 dark:text-zinc-300">
          <span class:list={[
            "w-1.5 h-1.5 rounded-full",
            project.status === 'active' ? "bg-emerald-500 animate-pulse" : "bg-indigo-500"
          ]}></span>
          {project.status === 'active' ? t('projects.status_active') : t('projects.status_completed')}
        </span>
      </div>

      <h3
        id={`project-title-${project.id}`}
        class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50"
      >
        {project.title}
      </h3>
      <p class="text-xs sm:text-sm font-medium text-zinc-600 dark:text-zinc-400 leading-relaxed">
        {project.tagline}
      </p>
    </div>

    <!-- Links: Repo & Live Demo -->
    <div class="flex flex-wrap items-center gap-2.5 shrink-0 font-mono text-xs">
      <a
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500 bg-zinc-50 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
        <span>{t('projects.repo')}</span>
        <span aria-hidden="true">&nearr;</span>
      </a>

      {project.liveUrl && !project.isLivePending && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-emerald-300 dark:border-emerald-800/80 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 font-medium transition-colors"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{t('projects.live')}</span>
          <span aria-hidden="true">&nearr;</span>
        </a>
      )}

      {project.isLivePending && (
        <span
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-100/60 dark:bg-zinc-800/50 text-zinc-500 dark:text-zinc-400 text-[11px]"
          title="El código y pipeline están completos en GitHub; la demo web está en proceso de despliegue."
        >
          <span>{t('projects.live_pending')}</span>
        </span>
      )}
    </div>
  </div>

  <!-- Technical Deep-Dive Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Visual Proof & Pipeline Flow (Col 1-5) -->
    <div class="lg:col-span-5 space-y-4">
      <!-- Screenshot / Preview Frame -->
      <div class="w-full aspect-video overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
        <img
          src={project.image}
          alt={`Visual preview of ${project.title}`}
          loading="lazy"
          class="w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-102"
        />
      </div>

      <!-- Data Source Card -->
      <div class="p-3.5 rounded-xl border border-zinc-200/90 dark:border-zinc-800/90 bg-zinc-50/70 dark:bg-zinc-950/50 space-y-2">
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7zm0 5h16M4 12c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3" />
          </svg>
          {t('projects.data_source')}
        </h4>
        <div class="space-y-1 text-xs">
          <p class="text-zinc-800 dark:text-zinc-200 font-medium">
            {project.dataSource.origin}
          </p>
          <p class="text-zinc-500 dark:text-zinc-400 font-mono text-[11px]">
            &bull; {project.dataSource.format}
          </p>
          <p class="text-zinc-500 dark:text-zinc-400 font-mono text-[11px]">
            &bull; {project.dataSource.frequency}
          </p>
        </div>
      </div>
    </div>

    <!-- Technical Details & Design Decisions (Col 6-12) -->
    <div class="lg:col-span-7 space-y-5 text-xs sm:text-sm">
      <!-- 1. El Problema -->
      <div class="space-y-1.5">
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
          {t('projects.problem')}
        </h4>
        <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
          {project.problem}
        </p>
      </div>

      <!-- 2. Arquitectura & DAG Flow -->
      <div class="space-y-2.5">
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
          {t('projects.architecture')}
        </h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
          {project.architectureDetails}
        </p>
        <!-- Mini DAG Component -->
        <ProjectArchitectureDiagram nodes={project.architectureFlow} />
      </div>

      <!-- 3. Transformaciones & Modelado -->
      <div class="space-y-1.5">
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
          {t('projects.transformations')}
        </h4>
        <ul class="space-y-1 text-zinc-600 dark:text-zinc-400 list-disc list-inside leading-relaxed text-xs">
          {project.transformations.map((item) => (
            <li>
              <span class="text-zinc-700 dark:text-zinc-300 font-normal">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- 4. Control de Calidad & Testing -->
      <div class="space-y-1.5">
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          {t('projects.quality')}
        </h4>
        <ul class="space-y-1 text-zinc-600 dark:text-zinc-400 list-disc list-inside leading-relaxed text-xs">
          {project.qualityControls.map((item) => (
            <li>
              <span class="text-zinc-700 dark:text-zinc-300 font-normal">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- 5. Resultados & Entregables -->
      <div class="space-y-1.5">
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
          {t('projects.results')}
        </h4>
        <ul class="space-y-1 text-zinc-600 dark:text-zinc-400 list-disc list-inside leading-relaxed text-xs">
          {project.results.map((item) => (
            <li>
              <span class="text-zinc-700 dark:text-zinc-300 font-normal">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Card Footer: Tech Stack Badges -->
  <div class="pt-4 border-t border-zinc-200/80 dark:border-zinc-800/80 flex flex-wrap items-center gap-2">
    <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400 mr-1">
      {t('projects.tech_stack')}
    </span>
    {project.stack.map((tech) => (
      <span class="font-mono text-xs px-2.5 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/60 shadow-2xs">
        {tech}
      </span>
    ))}
  </div>
</article>
