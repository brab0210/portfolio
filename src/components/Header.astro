---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const basePath = `/${lang}/`;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#f8fafc]/85 dark:bg-[#09090b]/85 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Identifier -->
    <a
      href={basePath}
      class="group flex items-center gap-2 text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors"
    >
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-zinc-900 dark:bg-zinc-100 text-zinc-100 dark:text-zinc-900 font-mono text-xs font-bold tracking-normal group-hover:scale-105 transition-transform">
        BA
      </span>
      <span class="flex flex-col sm:flex-row sm:items-baseline sm:gap-1.5 leading-tight">
        <span>Bernardo Arrechea</span>
        <span class="text-[11px] font-mono font-normal text-zinc-500 dark:text-zinc-400">
          [data.engineer]
        </span>
      </span>
    </a>

    <!-- Desktop Navigation & Controls -->
    <div class="hidden md:flex items-center gap-6">
      <nav aria-label="Navegación principal">
        <ul class="flex items-center gap-5 text-xs font-medium text-zinc-600 dark:text-zinc-400">
          <li>
            <a href="#proyectos" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors">
              {t('nav.projects')}
            </a>
          </li>
          <li>
            <a href="#habilidades" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors">
              {t('nav.skills')}
            </a>
          </li>
          <li>
            <a href="#sobre-mi" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors">
              {t('nav.about')}
            </a>
          </li>
          <li>
            <a href="#contacto" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors">
              {t('nav.contact')}
            </a>
          </li>
        </ul>
      </nav>

      <div class="h-4 w-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true"></div>

      <!-- Controls: CV, i18n & Theme -->
      <div class="flex items-center gap-2.5">
        <a
          href="/cv-bernardo-arrechea.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-mono font-medium rounded-md border border-zinc-300 dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500 text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-zinc-100 bg-white dark:bg-zinc-900 transition-colors"
          title={t('hero.cta_resume')}
        >
          <span>{t('nav.resume')}</span>
          <svg class="w-3 h-3 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </a>

        <LanguageToggle lang={lang} />
        <ThemeToggle lang={lang} />
      </div>
    </div>

    <!-- Mobile Menu Button & Mobile Controls -->
    <div class="flex md:hidden items-center gap-2">
      <LanguageToggle lang={lang} />
      <ThemeToggle lang={lang} />

      <button
        id="mobile-menu-button"
        type="button"
        class="p-2 rounded-lg text-zinc-600 hover:text-zinc-950 hover:bg-zinc-200/60 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800/60 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('nav.menu_open')}
      >
        <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-zinc-200 dark:border-zinc-800 bg-[#f8fafc] dark:bg-[#09090b] px-4 pt-2 pb-4 space-y-3"
  >
    <nav aria-label="Navegación móvil">
      <ul class="flex flex-col space-y-2 text-sm font-medium text-zinc-700 dark:text-zinc-300">
        <li>
          <a href="#proyectos" class="mobile-nav-link block py-1.5 hover:text-zinc-950 dark:hover:text-zinc-100">
            {t('nav.projects')}
          </a>
        </li>
        <li>
          <a href="#habilidades" class="mobile-nav-link block py-1.5 hover:text-zinc-950 dark:hover:text-zinc-100">
            {t('nav.skills')}
          </a>
        </li>
        <li>
          <a href="#sobre-mi" class="mobile-nav-link block py-1.5 hover:text-zinc-950 dark:hover:text-zinc-100">
            {t('nav.about')}
          </a>
        </li>
        <li>
          <a href="#contacto" class="mobile-nav-link block py-1.5 hover:text-zinc-950 dark:hover:text-zinc-100">
            {t('nav.contact')}
          </a>
        </li>
        <li class="pt-2 border-t border-zinc-200 dark:border-zinc-800">
          <a
            href="/cv-bernardo-arrechea.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-zinc-900 dark:text-zinc-100"
          >
            <span>{t('hero.cta_resume')}</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>

