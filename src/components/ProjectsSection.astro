---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { projectsData } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = projectsData[lang];
---

<section
  id="proyectos"
  class="scroll-reveal opacity-0 translate-y-8 transition-all duration-500 ease-out space-y-8 scroll-mt-20"
  aria-labelledby="projects-section-title"
>
  <!-- Section Title & Subtitle -->
  <div class="border-b border-zinc-200/80 dark:border-zinc-800/80 pb-4">
    <div class="flex items-center gap-2 mb-1">
      <span class="font-mono text-xs uppercase tracking-wider text-indigo-600 dark:text-indigo-400 font-semibold">
        [01] // Pipeline Case Studies
      </span>
    </div>
    <h2
      id="projects-section-title"
      class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50"
    >
      {t('sections.projects_title')}
    </h2>
    <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
      {t('sections.projects_subtitle')}
    </p>
  </div>

  <!-- Case Studies List -->
  <div class="space-y-8">
    {projects.map((project) => (
      <ProjectCard project={project} lang={lang} />
    ))}
  </div>
</section>

<!-- ───── Lightbox Modal (global, one instance for all cards) ───── -->
<div
  id="lightbox-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Vista completa de imagen"
  class="fixed inset-0 z-[300] flex items-center justify-center bg-black/90 backdrop-blur-sm
         opacity-0 pointer-events-none transition-opacity duration-200"
>
  <!-- Close backdrop -->
  <button
    id="lightbox-backdrop"
    type="button"
    class="absolute inset-0 w-full h-full cursor-zoom-out"
    aria-label="Cerrar lightbox"
  ></button>

  <!-- Image container -->
  <div class="relative z-10 flex flex-col items-center gap-3 px-4 max-w-[95vw] max-h-[95vh]">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-[92vw] max-h-[88vh] rounded-xl shadow-2xl object-contain"
    />
    <!-- Close button -->
    <button
      id="lightbox-close"
      type="button"
      class="absolute -top-3 -right-3 w-8 h-8 flex items-center justify-center rounded-full
             bg-zinc-800 hover:bg-zinc-700 text-zinc-100 transition-colors shadow-lg"
      aria-label="Cerrar"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<script>
  (function () {
    const modal   = document.getElementById('lightbox-modal');
    const img     = document.getElementById('lightbox-img') as HTMLImageElement;
    const backdrop = document.getElementById('lightbox-backdrop');
    const closeBtn = document.getElementById('lightbox-close');
    if (!modal || !img || !backdrop || !closeBtn) return;

    function openLightbox(src: string, alt: string) {
      img.src = src;
      img.alt = alt;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      document.body.style.overflow = '';
      // Clear src after fade-out to avoid flash on next open
      setTimeout(() => { img.src = ''; }, 200);
    }

    // Wire up all lightbox triggers (now and after any future Astro navigation)
    function attachTriggers() {
      document.querySelectorAll<HTMLElement>('[data-lightbox-src]').forEach((trigger) => {
        if (trigger.dataset.lightboxBound) return; // avoid duplicate listeners
        trigger.dataset.lightboxBound = '1';
        trigger.addEventListener('click', () => {
          openLightbox(trigger.dataset.lightboxSrc!, trigger.dataset.lightboxAlt || '');
        });
      });
    }

    backdrop.addEventListener('click', closeLightbox);
    closeBtn.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    // Run on initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', attachTriggers);
    } else {
      attachTriggers();
    }
  })();
</script>
